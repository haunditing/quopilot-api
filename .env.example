PORT=3000
MONGODB_URI=
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Versión de Node requerida por mongodb@7 (>= 20.19). En Railway:
#   Variables → NIXPACKS_NODE_VERSION=22   (o usa engines.node del package.json)
NIXPACKS_NODE_VERSION=22
DEMO_TENANT_NAME=
DEMO_TENANT_EMAIL=
DEMO_TENANT_ADMIN_NAME=
DEMO_TENANT_ADMIN_PASSWORD=

# Revalidación on-demand de la landing (opcional). Sin estos valores, no se notifica.
LANDING_REVALIDATE_URL=http://localhost:3001
LANDING_REVALIDATE_SECRET=change-me

# Provisioning del tenant (npm run provision:company)
PROVISION_API_URL=http://localhost:3000
LANDING_TENANT_NAME=QuoPilot
LANDING_TENANT_EMAIL=ventas@quopilot.com
LANDING_TENANT_ADMIN=Ventas
LANDING_TENANT_PASSWORD=quopilot2026